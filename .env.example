# Local mode binds to loopback. Do not expose it to the internet.
PORT=4318
ENGINE_DATA_DIR=.data
# For remote use, set ENGINE_HOST=0.0.0.0, ENGINE_ORIGIN to the exact HTTPS origin,
# and ENGINE_ACCESS_TOKEN to a unique secret of at least 32 characters.
# Place an HTTPS reverse proxy in front of the server. See docs/deployment.md.
# ENGINE_HOST=0.0.0.0
# ENGINE_ORIGIN=https://studio.example.com
# ENGINE_ACCESS_TOKEN=
# Official Meta adapter. No credentials are included or inherited.
# Use a supported Graph API version from your Meta app dashboard.
# META_GRAPH_VERSION=
# Choose instagram for direct Instagram Login, or facebook for Facebook Login.
# META_LOGIN_TYPE=facebook
# META_ACCESS_TOKEN=
# META_INSTAGRAM_ID=
# META_FACEBOOK_PAGE_ID=
# META_PUBLIC_MEDIA_BASE=https://assets.example.com/virax
# ENGINE_LIVE_PUBLISH=false
# Google Drive. Each installation uses its own Google OAuth application.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4318/api/drive/callback
